# traefik-configmap.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: traefik-config
  namespace: traefik-system
data:
  traefik.yaml: |
    entryPoints:
      web:
        address: ":8000"
        http:
          redirections:
            entryPoint:
              to: websecure
              scheme: https
      websecure:
        address: ":8443"

    providers:
      kubernetesCRD:
        allowCrossNamespace: true
      kubernetesIngress: {}

    api:
      dashboard: true

    log:
      level: INFO

    accessLog: {}
